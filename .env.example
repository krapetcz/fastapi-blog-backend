# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed so the required keys stay documented.

# ----------------------------------------------------------------------------
# Auth0
# ----------------------------------------------------------------------------

# Auth0 tenant domain (no scheme), e.g. dev-xxx.us.auth0.com
AUTH0_DOMAIN=

# API audience configured in Auth0 — must match the API's Identifier.
AUTH0_AUDIENCE=

# Token issuer. Auth0 uses https://<AUTH0_DOMAIN>/ — note the trailing slash,
# it must match the `iss` claim in the JWT byte-for-byte.
AUTH0_ISSUER=

# ----------------------------------------------------------------------------
# Authorization
# ----------------------------------------------------------------------------

# Comma-separated list of emails that may perform write operations
# (POST/PUT/DELETE /articles). Example: alice@example.com,bob@example.com
ADMIN_EMAILS=
